@echo off
setlocal EnableExtensions
title DSH diagnostics collector

set "HERE=%~dp0"
set "OUT=%USERPROFILE%\Desktop\DSH-diagnostics"

if exist "%OUT%" rd /s /q "%OUT%" >nul 2>&1
mkdir "%OUT%" >nul 2>&1
if not exist "%OUT%" (
  echo [ERROR] cannot create %OUT%
  pause
  exit /b 1
)

echo Collecting diagnostic information ...
echo.

rem ---- 1. bootstrap logs ----
copy /y "%TEMP%\DSH-install-boot.log"   "%OUT%\" >nul 2>&1
copy /y "%TEMP%\DSH-install-output.log" "%OUT%\" >nul 2>&1
copy /y "%USERPROFILE%\Desktop\DSH-install-output.txt" "%OUT%\console-mode-output.txt" >nul 2>&1

rem ---- 2. the REAL installer log (this is where the GUI error lands) ----
if exist "%LOCALAPPDATA%\DSH-Installer" (
  xcopy /y /q "%LOCALAPPDATA%\DSH-Installer\*.log" "%OUT%\" >nul 2>&1
  xcopy /y /q /s "%LOCALAPPDATA%\DSH-Installer\*" "%OUT%\DSH-Installer-folder\" >nul 2>&1
)

rem ---- 3. environment ----
> "%OUT%\01-environment.txt" echo ==== when ====
>>"%OUT%\01-environment.txt" echo %date% %time%
>>"%OUT%\01-environment.txt" echo ==== machine ====
>>"%OUT%\01-environment.txt" echo COMPUTERNAME=%COMPUTERNAME%
>>"%OUT%\01-environment.txt" echo USERNAME=%USERNAME%
>>"%OUT%\01-environment.txt" echo ARCH=%PROCESSOR_ARCHITECTURE%
>>"%OUT%\01-environment.txt" ver
>>"%OUT%\01-environment.txt" echo ==== installer folder ====
>>"%OUT%\01-environment.txt" echo %HERE%
>>"%OUT%\01-environment.txt" dir /b "%HERE%"
>>"%OUT%\01-environment.txt" echo.
>>"%OUT%\01-environment.txt" echo NOTE: if the path above contains ".zip" you ran it
>>"%OUT%\01-environment.txt" echo       from inside the archive - that always fails.

set "PSEXE=%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe"
if not exist "%PSEXE%" set "PSEXE=powershell.exe"

rem ---- 4. THE KEY TEST (passed as base64 so cmd cannot mangle it) ----
echo Running WPF / .NET test ...
"%PSEXE%" -NoProfile -STA -EncodedCommand  > "%OUT%\02-wpf-and-dotnet.txt" 2>&1

rem ---- 5. execution policy ----
"%PSEXE%" -NoProfile -Command "Get-ExecutionPolicy -List | Out-String" > "%OUT%\03-execution-policy.txt" 2>&1

rem ---- 6. antivirus ----
"%PSEXE%" -NoProfile -Command "Get-CimInstance -Namespace root/SecurityCenter2 -ClassName AntiVirusProduct -ErrorAction SilentlyContinue | Select-Object displayName,productState | Format-List | Out-String" > "%OUT%\04-antivirus.txt" 2>&1

rem ---- 7. show result on screen ----
echo.
echo  ================================================================
echo   Result of the key test:
echo  ================================================================
type "%OUT%\02-wpf-and-dotnet.txt"
echo.
echo  ================================================================
echo   Everything was collected into:
echo     %OUT%
echo   Please ZIP that folder and send it to the developer.
echo  ================================================================
echo.
start "" "%OUT%"
pause
