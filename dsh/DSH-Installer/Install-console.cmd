@echo off
setlocal EnableExtensions
title DSH Installer - console mode
rem ============================================================================
rem  DSH installer  -  CONSOLE MODE
rem  Never loads the WPF GUI.  Portable ZIP mode: no admin rights, no UAC.
rem  Uses Start-Transcript so EVERYTHING (including errors) lands in the log.
rem  Keep this file PURE ASCII.
rem ============================================================================

set "HERE=%~dp0"
set "PS1=%HERE%Install-DSH.ps1"
set "DSH_HERE=%HERE%"
set "DSH_CONSOLE_LOG=%USERPROFILE%\Desktop\DSH-install-output.txt"

echo.
echo  ================================================================
echo    DSH Installer  -  CONSOLE MODE
echo  ================================================================
echo    Folder : %HERE%
echo    Log    : %DSH_CONSOLE_LOG%
echo.

if not exist "%PS1%" goto NO_PS1

set "PSEXE=%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe"
if not exist "%PSEXE%" set "PSEXE=powershell.exe"

set "INZIP="
if not "%HERE%"=="%HERE:.zip\=%" set "INZIP=1"
if defined INZIP goto IN_ZIP

echo  Starting. Everything is written to the log file, so nothing is
echo  lost even if you close this window. The log opens in Notepad
echo  when it finishes.
echo.

"%PSEXE%" -NoProfile -STA -ExecutionPolicy Bypass -EncodedCommand 
set "CODE=%ERRORLEVEL%"

echo.
echo  ================================================================
echo   Finished. Exit code: %CODE%
echo   Log file: %DSH_CONSOLE_LOG%
echo  ================================================================
echo.

if exist "%DSH_CONSOLE_LOG%" start "" notepad "%DSH_CONSOLE_LOG%"

echo  (Press any key to close this window.)
pause
exit /b %CODE%

:NO_PS1
echo  [ERROR] Install-DSH.ps1 was not found next to this file.
echo          This folder : %HERE%
echo          Extract the WHOLE folder from the zip, then run again.
echo.
pause
exit /b 1

:IN_ZIP
echo  [ERROR] You are running inside the ZIP temp folder.
echo          RIGHT-CLICK the zip, choose "Extract All", then run this
echo          file from the extracted folder.
echo          Current path: %HERE%
echo.
pause
exit /b 1
